# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=closevia

# Server Configuration
APP_ENV=local
PORT=4000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=json

# Environment files
# Local: copy this file to .env
# Staging/Production: keep separate secret-managed values and set APP_ENV=staging or APP_ENV=production

# Debug (do not enable in production)
# Enables debug-only API endpoints like /api/deliveries/my-jobs-debug
ENABLE_DEBUG_ENDPOINTS=false

# Frontend (Vite)
# Put this in client/.env to show dev-only diagnostics UI
# VITE_ENABLE_DEBUG_UI=false

# JWT Configuration (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Xendit incoming payment configuration
# Clovia accepts incoming invoice payments only. Do not configure payout,
# withdrawal, or disbursement credentials for the app runtime.
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# Web Push Notifications (generate with: go run ./cmd/generate_vapid)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@cloviaph.site

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Session cookie configuration
# Development usually works with Lax/false on localhost.
# Production with a separate frontend origin typically needs None/true.
# Leave AUTH_COOKIE_DOMAIN empty when using the __Host- cookie variant.
# Only set a domain if you intentionally need cross-subdomain cookies.
# Important for local auth: use the same host consistently for frontend and API.
# `localhost` and `127.0.0.1` are different cookie hosts in the browser.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Groq AI Configuration (Vision - Higher limits than Gemini)
GROQ_API_KEY=your-groq-api-key-here

# Cloudinary Configuration
CLOUDINARY_URL=cloudinary://key:secret@cloud_name
CLOUDINARY_UPLOAD_PRESET=clovia_unsigned
CLOUDINARY_FOLDER_PREFIX=clovia
