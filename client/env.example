# CloviaPH frontend environment
# Local: copy to client/.env
# Staging: use client/.env.staging or host-managed staging variables
# Production: use client/.env.production or host-managed production variables

VITE_API_URL=http://localhost:4000
VITE_ENABLE_DEBUG_UI=false

# Session timing
VITE_SESSION_IDLE_TIMEOUT_MINUTES=60
VITE_SESSION_TIMEOUT_WARNING_SECONDS=60

# Firebase Cloud Messaging / push notifications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
