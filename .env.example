# Database Configuration
DB_HOST=your-database-host
DB_PORT=your-database-port
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name
DB_CA_CERT=ca.pem
SSL_MODE=REQUIRED

# Server Configuration
PORT=4000
APP_TIMEZONE=Asia/Manila
WAKE_TIMEZONE=Asia/Manila
# CloviaPH active wake window is Philippine time: 06:00-23:59 Asia/Manila.
# For UTC-only schedulers, that is 22:00-15:59 UTC.
WAKE_ACTIVE_START_HOUR=6
WAKE_ACTIVE_END_HOUR=24
WAKE_PING_INTERVAL_MINUTES=15

# JWT Configuration (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Web Push Notifications (generate with: go run ./cmd/generate_vapid)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@cloviaph.site

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-url.netlify.app

# Xendit Configuration
XENDIT_SECRET_KEY=xnd_test_your_secret_key_here
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token_here
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_URL=cloudinary://your-cloudinary-url
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_FOLDER_PREFIX=your-folder-prefix

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
