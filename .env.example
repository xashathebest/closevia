# Copy this to .env and fill real secret values. Do NOT commit .env.
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/closevia?sslmode=disable
JWT_SECRET=replace_with_secure_secret
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=info
# any other app-specific keys:
# S3_ENDPOINT=...
# S3_BUCKET=...
