# CloviaPH staging environment
# Copy to .env.staging on a disposable staging host only.
# Never point this file at production or a real user database.

APP_ENV=staging
PORT=4000
FRONTEND_URL=https://staging.example.com
LOG_LEVEL=info
LOG_FORMAT=json

# Disposable staging database only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clovia_staging
DB_PASSWORD=replace-with-staging-password
DB_NAME=clovia_staging

# Auth/session secrets for staging only.
JWT_SECRET=replace-with-long-random-staging-secret
JWT_TTL_HOURS=24
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_PATH=/

# Staging CORS origins only.
CORS_ORIGINS=https://staging.example.com,http://localhost:5173

# Staging services. Use sandbox/test credentials only.
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:staging@example.com
CLOUDINARY_URL=
CLOUDINARY_UPLOAD_PRESET=clovia_staging_unsigned
CLOUDINARY_FOLDER_PREFIX=clovia-staging
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=

# Keep debug endpoints off unless a staging-only test explicitly requires them.
ENABLE_DEBUG_ENDPOINTS=false
